# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — sidecar/ has its own node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval results (timestamped run outputs — not committed)
/evals/results/

# Local backup of pre-compression strength posters (28MB) — not deployed
assets/strength-posters-original/

# Local-only archives
stripe.tar.gz
